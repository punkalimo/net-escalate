# NetEscalate
MONGODB_URI=mongodb://127.0.0.1:27017/net-escalate
PORT=5000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# Remote MCP + OAuth bridge (docs/WEBMCP.md "Remote MCP + OAuth") - only
# needed if you're connecting ChatGPT or another remote MCP client.
# MCP_OAUTH_REDIRECT_URIS is comma-separated; leave empty to disable the
# bridge (every /oauth/authorize request will be rejected).
MCP_OAUTH_CLIENT_ID=chatgpt-connector
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_REDIRECT_URIS=

# Incident call provider
CALL_PROVIDER=calle

# CALL-E Developer API
CALLE_API_KEY=calle_live_key_here
CALLE_BASE_URL=https://api.heycall-e.com
CALLE_REGION=ZM
CALLE_LOCALE=en-ZM
CALLE_POLL_INTERVAL_MS=5000
CALLE_MAX_WAIT_MS=180000

# Set CALL_PROVIDER=simulation to use the local simulator instead.
